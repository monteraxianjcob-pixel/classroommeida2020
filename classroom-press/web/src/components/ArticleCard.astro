---
import Photo from './Photo.astro';
import { displayHeadline, categoryLabel, formatShortDate, plainExcerpt, type Article } from '../lib/loadArticles';

interface Props { article: Article; variant?: 'standard' | 'banner' | 'row' }
const { article, variant = 'standard' } = Astro.props;
const href = `/article/${article.slug}/`;
---
<article class:list={['card', `card--${variant}`, { 'is-breaking': article.urgency === 'breaking' }]}>
  <p class="label"><a href={`/section/${article.category}/`}>{categoryLabel(article.category)}</a></p>
  <h3 class="card__headline"><a href={href}>{displayHeadline(article)}</a></h3>
  {variant === 'standard' && (
    <Photo src={article.photo} caption={article.photo_caption} credit={article.photo_credit} variant="card" />
  )}
  {variant !== 'row' && article.subhead && <p class="card__subhead">{article.subhead}</p>}
  <p class="byline">
    {article.author && <span>By {article.author}</span>}
    {article.date && <span>{formatShortDate(article.date)}</span>}
    {variant !== 'row' && article.due_at && <span class="countdown" data-due={article.due_at}></span>}
  </p>
  {variant === 'standard' && <p class="card__excerpt">{plainExcerpt(article.body, 28)}</p>}
</article>

---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { loadData, sectionOrder, categoryLabel, CATEGORY_LABELS, type Article } from '../../lib/loadArticles';

export function getStaticPaths() {
  return Object.keys(CATEGORY_LABELS).map((cat) => ({ params: { cat } }));
}

const { cat } = Astro.params as { cat: string };
const data = loadData();
const nowMs = Date.now();
const section = data.sections.find((s) => s.slug === cat);
const articles: Article[] = sectionOrder(data.articles.filter((a) => a.category === cat), nowMs);
---
<Base title={categoryLabel(cat)}>
  <div class="page">
    <Masthead
      edition={data.edition}
      volume={data.volume}
      generatedAt={data.generatedAt}
      sections={data.sections}
      current={cat}
    />
    <main class="listing">
      <h1 class="listing__title">{categoryLabel(cat)}</h1>
      {section && <p class="listing__desc">{section.description}</p>}
      {articles.length === 0 ? (
        <p class="empty">No {categoryLabel(cat).toLowerCase()} stories yet. New notices appear here as soon as they are posted.</p>
      ) : (
        <div class="listing__grid">
          {articles.map((a) => <ArticleCard article={a} />)}
        </div>
      )}
    </main>
  </div>
</Base>

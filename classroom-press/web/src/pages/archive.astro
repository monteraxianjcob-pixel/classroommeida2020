---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { loadData, dueMs, type Article } from '../lib/loadArticles';

const data = loadData();
const nowMs = Date.now();
const archived = data.articles.filter((a) => a.urgency === 'archive');
const later = archived.filter((a) => dueMs(a) > nowMs).sort((x, y) => dueMs(x) - dueMs(y));
const past = archived.filter((a) => !later.includes(a)).sort((x, y) => (y.date ?? '').localeCompare(x.date ?? ''));

const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const groups: { label: string; items: Article[] }[] = [];
for (const a of past) {
  const label = a.date ? `${MONTHS[Number(a.date.slice(5, 7)) - 1]} ${a.date.slice(0, 4)}` : 'Undated';
  const last = groups[groups.length - 1];
  if (last && last.label === label) last.items.push(a);
  else groups.push({ label, items: [a] });
}
---
<Base title="Archive">
  <div class="page">
    <Masthead
      edition={data.edition}
      volume={data.volume}
      generatedAt={data.generatedAt}
      sections={data.sections}
      current="archive"
    />
    <main class="listing">
      <h1 class="listing__title">Archive</h1>
      <p class="listing__desc">Past notices by date, and items due more than a week from now.</p>

      {later.length > 0 && (
        <section class="archive__group">
          <h2 class="label archive__month">Due later</h2>
          <div class="archive__rows">{later.map((a) => <ArticleCard article={a} variant="row" />)}</div>
        </section>
      )}
      {groups.map((g) => (
        <section class="archive__group">
          <h2 class="label archive__month">{g.label}</h2>
          <div class="archive__rows">{g.items.map((a) => <ArticleCard article={a} variant="row" />)}</div>
        </section>
      ))}
      {later.length === 0 && groups.length === 0 && (
        <p class="empty">The archive is empty. Notices land here once their due date has passed.</p>
      )}
    </main>
  </div>
</Base>

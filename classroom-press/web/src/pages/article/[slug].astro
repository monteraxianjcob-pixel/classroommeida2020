---
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import Photo from '../../components/Photo.astro';
import { loadData, displayHeadline, categoryLabel, formatShortDate, type Article } from '../../lib/loadArticles';
import { renderMarkdown } from '../../lib/markdown';

export function getStaticPaths() {
  const { articles } = loadData();
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const data = loadData();
const headline = displayHeadline(article);
const place = (article.location ?? 'Classroom').toUpperCase();
const dateline = `${place}${article.date ? `, ${formatShortDate(article.date)}` : ''} \u2014`;
const html = renderMarkdown(article.body, { dateline });
const facts: [string, string | null][] = [
  ['Subject', article.subject],
  ['Due', article.date ? formatShortDate(article.date) : null],
  ['Where', article.location],
  ['Covers', article.scope],
  ['Required', article.requirement],
  ['Restrictions', article.restriction],
];
const shown = facts.filter(([, v]) => v);
---
<Base title={headline} description={article.subhead ?? undefined}>
  <div class="page">
    <Masthead
      edition={data.edition}
      volume={data.volume}
      generatedAt={data.generatedAt}
      sections={data.sections}
      current={article.category}
    />
    <main class:list={['article', { 'is-breaking': article.urgency === 'breaking' }]}>
      <p class="label"><a href={`/section/${article.category}/`}>{categoryLabel(article.category)}</a></p>
      <h1 class="article__headline">{headline}</h1>
      {article.subhead && <p class="article__subhead">{article.subhead}</p>}
      <p class="byline byline--article">
        {article.author && <span>By {article.author}</span>}
        {article.date && <span>{formatShortDate(article.date)}</span>}
        {article.due_at && <span class="countdown" data-due={article.due_at}></span>}
      </p>
      <Photo src={article.photo} caption={article.photo_caption} credit={article.photo_credit} variant="wide" />
      {shown.length > 0 && (
        <dl class="article__facts">
          {shown.map(([k, v]) => (<div><dt class="label">{k}</dt><dd>{v}</dd></div>))}
        </dl>
      )}
      <div class="article__body" set:html={html} />
      <p class="more"><a href="/">Back to the front page</a></p>
    </main>
  </div>
</Base>

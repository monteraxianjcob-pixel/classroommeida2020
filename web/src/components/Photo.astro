---
// Wraps an image in the newsprint treatment (grayscale + halftone + vignette,
// multiplied against the paper) with a captioned figure.
interface Props {
  src: string | null;
  caption?: string | null;
  credit?: string | null;
  alt?: string;
  variant?: 'lead' | 'wide' | 'card';
}
const { src, caption, credit, alt = '', variant = 'wide' } = Astro.props;
---
{src && (
  <figure class={`photo photo--${variant}`}>
    <div class="photo__frame">
      <img src={src} alt={alt || caption || ''} loading={variant === 'lead' ? 'eager' : 'lazy'} />
    </div>
    {(caption || credit) && (
      <figcaption class="photo__figcaption">
        {caption && <span class="photo__caption">{caption}</span>}
        {credit && <span class="photo__credit">{credit}</span>}
      </figcaption>
    )}
  </figure>
)}

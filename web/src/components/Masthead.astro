---
import { SITE, formatLongDate, categoryLabel } from '../lib/loadArticles';

interface Props {
  edition: number;
  volume: number;
  generatedAt: string;
  sections: { slug: string; label?: string }[];
  current?: string; // slug of the active section, or 'archive'
}
const { edition, volume, generatedAt, sections, current } = Astro.props;
---
<header class="masthead">
  <div class="masthead__top">
    <p class="masthead__name"><a href="/">{SITE.name}</a></p>
    <div class="masthead__stamp">
      <span class="masthead__edition">Vol. {volume}, No. {edition}</span>
      <span class="masthead__class">{SITE.className}</span>
    </div>
  </div>
  <p class="masthead__date"><time datetime={generatedAt.slice(0, 10)}>{formatLongDate(generatedAt)}</time></p>
  <nav class="masthead__nav" aria-label="Sections">
    <a href="/" aria-current={current === 'home' ? 'page' : undefined}>Front page</a>
    {sections.map((s) => (
      <a href={`/section/${s.slug}/`} aria-current={current === s.slug ? 'page' : undefined}>
        {s.label ?? categoryLabel(s.slug)}
      </a>
    ))}
    <a href="/archive/" aria-current={current === 'archive' ? 'page' : undefined}>Archive</a>
  </nav>
</header>
